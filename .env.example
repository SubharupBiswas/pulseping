# Datastore (PostgreSQL)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/pulseping?schema=public"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Payments (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Internal Security & Cron
CRON_SECRET="your_secure_cron_secret"
ADMIN_EMAILS="admin@example.com,subharup@example.com"

# AI Diagnostics Waterfall
GEMINI_API_KEY=
OMNIROUTE_API_KEY= # Optional: Local OmniRoute gateway key
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1 # Optional: Default local OmniRoute port
GROQ_API_KEY=

# Email & Telegram Dispatch
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="PulsePing Alerts <alerts@subharup.com>"
TELEGRAM_BOT_TOKEN="your_bot_token"

# Application Base URL & Analytics
NEXT_PUBLIC_APP_URL="https://pulseping.subharup.com"
NEXT_PUBLIC_GA_ID="G-..."
